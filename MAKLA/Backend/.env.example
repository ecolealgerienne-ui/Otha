# =================================
# DATABASE
# =================================
DATABASE_URL="postgresql://makla:makla_password@localhost:5432/makla?schema=public"

# Pour Docker Compose (utilise le service postgres_makla)
# DATABASE_URL="postgresql://makla:makla_password@postgres_makla:5432/makla?schema=public"

# =================================
# JWT SECRETS (min 32 characters)
# =================================
# Générer avec: openssl rand -base64 32
JWT_ACCESS_SECRET="your-super-secret-access-key-min-32-chars-please-change-me"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-min-32-chars-please-change-me"
JWT_ACCESS_TTL="30d"
JWT_REFRESH_TTL="60d"

# =================================
# EMAIL SMTP CONFIGURATION
# =================================
# For Gmail:
#   1. Enable 2-Factor Authentication on your Google account
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create an App Password for "Mail" and "Other (Custom name)"
#   4. Use that 16-character password as SMTP_PASS
#
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"

# =================================
# OVH OBJECT STORAGE (S3)
# =================================
# Credentials from OVH Cloud > Object Storage > S3 Users
S3_ACCESS_KEY_ID="your-ovh-access-key-id"
S3_SECRET_ACCESS_KEY="your-ovh-secret-access-key"

# Buckets
S3_BUCKET_VIDEOS="makla-videos"
S3_BUCKET_IMAGES="makla-images"

# Endpoints
S3_ENDPOINT="https://s3.rbx.io.cloud.ovh.net"
S3_PUBLIC_ENDPOINT="https://makla-videos.s3.rbx.io.cloud.ovh.net"

# Region (rbx = Roubaix, gra = Gravelines, sbg = Strasbourg)
AWS_REGION="rbx"

# Force path style (required for OVH)
S3_FORCE_PATH_STYLE="true"

# Use ACL to make files public (required for OVH)
S3_USE_OBJECT_ACL="true"

# =================================
# APPLICATION
# =================================
NODE_ENV="development"
PORT=3000

# CORS Origins (comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,https://makla.dz"

# =================================
# REDIS (Cache - Optionnel)
# =================================
# Pour local: redis://localhost:6379
# Pour Docker Compose: redis://redis_makla:6379
REDIS_URL="redis://localhost:6379"

# =================================
# POSTGRES PASSWORD (pour Docker Compose)
# =================================
POSTGRES_PASSWORD="makla_secure_password_123"
